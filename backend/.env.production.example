# ==============================================
# KARDIYOLIVE BACKEND - PRODUCTION ENVIRONMENT
# ==============================================

# APPLICATION
NODE_ENV=production
PORT=5000

# DATABASE
MONGO_URI=mongodb+srv://kardiyolive:kardiyolive2548@kardiyolive.44a1l4a.mongodb.net/kardiyolive?retryWrites=true&w=majority&appName=kardiyolive

# JWT SECURITY
JWT_SECRET=your_super_secure_jwt_secret_key_here_32_characters_minimum
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_here_32_characters
JWT_EXPIRE=30d

# CORS & FRONTEND
FRONTEND_URL=https://kardiyolive.com
CORS_ORIGIN=https://kardiyolive.com

# EMAIL
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@kardiyolive.com
EMAIL_PASS=your_email_app_password

# PAYMENTS
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://api.iyzipay.com

# FILE STORAGE
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SECURITY
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
ENABLE_CSRF=true
ENABLE_HELMET=true

# MONITORING
LOG_LEVEL=info
ENABLE_METRICS=true
SENTRY_DSN=your_sentry_dsn_url

# REDIS
REDIS_URL=redis://localhost:6379 