# ==============================================
# KARDIYOLIVE E-COMMERCE PLATFORM
# PRODUCTION ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and update all values
# NEVER commit .env files to version control

# =================
# DATABASE
# =================
MONGO_URI=mongodb+srv://kardiyolive:kardiyolive2548@kardiyolive.44a1l4a.mongodb.net/?retryWrites=true&w=majority&appName=kardiyolive
MONGO_ROOT_USERNAME=kardiyolive
MONGO_ROOT_PASSWORD=kardiyolive2548

# Alternative local MongoDB setup
# MONGO_URI=mongodb://localhost:27017/kardiyolive

# =================
# SECURITY - JWT
# =================
# Generate these with: openssl rand -base64 32
JWT_SECRET=your_super_secure_jwt_secret_key_here_32_characters_minimum
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_here_32_characters
JWT_EXPIRE=30d

# =================
# APPLICATION
# =================
NODE_ENV=production
PORT=5000

# =================
# FRONTEND URLs
# =================
FRONTEND_URL=https://kardiyolive.com
CORS_ORIGIN=https://kardiyolive.com

# For staging
# FRONTEND_URL=https://staging.kardiyolive.com
# CORS_ORIGIN=https://staging.kardiyolive.com

# =================
# WHATSAPP INTEGRATION
# =================
# WhatsApp Business Phone Number (include country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=+905XXXXXXXXX
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# =================
# EMAIL CONFIGURATION
# =================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@kardiyolive.com
EMAIL_PASS=your_email_app_password

# Alternative SMTP providers
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST=smtp.mailgun.org

# =================
# PAYMENT GATEWAY
# =================
# Iyzico (Turkish payment gateway)
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://api.iyzipay.com

# =================
# FILE STORAGE
# =================
# Cloudinary for image storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =================
# SECURITY & RATE LIMITING
# =================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
ENABLE_CSRF=true
ENABLE_HELMET=true

# =================
# MONITORING & LOGGING
# =================
LOG_LEVEL=info
ENABLE_METRICS=true

# Sentry for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_url

# =================
# REDIS CACHE
# =================
REDIS_URL=redis://localhost:6379
# For Redis Cloud: redis://username:password@host:port

# =================
# SSL & DOMAIN
# =================
DOMAIN=kardiyolive.com
SSL_CERT_PATH=/etc/ssl/certs/kardiyolive.crt
SSL_KEY_PATH=/etc/ssl/private/kardiyolive.key

# =================
# ANALYTICS (Optional)
# =================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=your_pixel_id

# =================
# SOCIAL MEDIA
# =================
FACEBOOK_URL=https://facebook.com/kardiyolive
INSTAGRAM_URL=https://instagram.com/kardiyolive
TWITTER_URL=https://twitter.com/kardiyolive

# =================
# BUSINESS INFORMATION
# =================
COMPANY_NAME=Kardiyolive Ltd.
COMPANY_ADDRESS=Your Company Address
COMPANY_PHONE=+90 XXX XXX XX XX
SUPPORT_EMAIL=support@kardiyolive.com
INFO_EMAIL=info@kardiyolive.com

# =================
# FRONTEND ENVIRONMENT VARIABLES
# =================
# These should be set in frontend/.env.local as well
NEXT_PUBLIC_API_URL=https://api.kardiyolive.com
NEXT_PUBLIC_SITE_URL=https://kardiyolive.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=+905XXXXXXXXX

# =================
# DOCKER CONFIGURATION
# =================
REGISTRY=ghcr.io/yourusername
IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=kardiyolive

# =================
# BACKUP CONFIGURATION
# =================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=kardiyolive-backups
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# =================
# DEVELOPMENT/STAGING OVERRIDES
# =================
# Uncomment for staging environment
# NODE_ENV=staging
# FRONTEND_URL=https://staging.kardiyolive.com
# CORS_ORIGIN=https://staging.kardiyolive.com
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/kardiyolive_staging 